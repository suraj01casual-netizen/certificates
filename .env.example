# ==============================================================================
# Railway / Production Environment Variables
# Copy these or set them in Railway Dashboard -> Variables
# ==============================================================================

# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# Public Site URL (Used for QR code generation and verification links)
SITE_URL=https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Database (Automatically provided if you add a PostgreSQL service in Railway)
# DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Email Delivery (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-organization-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="CertHub Credentials <your-organization-email@gmail.com>"
